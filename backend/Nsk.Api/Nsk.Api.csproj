<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Nsk.Api</RootNamespace>
    <AssemblyName>Nsk.Api</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <!-- Единый источник демо-данных: его же импортирует фронтенд для офлайн-режима. -->
    <Content Include="..\..\frontend\src\data\seed.json" Link="Data\seed.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
